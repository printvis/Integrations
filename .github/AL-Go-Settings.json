{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v10.0/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/printvis/AL-Go-PTE-Template@main",
  "templateSha": "644a85f442ad8aad8d26f9d55ebe959af1554a64",
  "excludeEnvironments": [
    "copilot"
  ],
  "customALGoFiles": {
    "filesToInclude": [
      {
        "sourceFolder": ".github/scripts",
        "filter": "*",
        "destinationFolder": ".github/scripts"
      },
      {
        "sourceFolder": ".github/scripts/GitHub",
        "filter": "*",
        "destinationFolder": ".github/scripts/GitHub"
      },
      {
        "sourceFolder": ".github/scripts/PullRequestValidation",
        "filter": "*",
        "destinationFolder": ".github/scripts/PullRequestValidation"
      },
      {
        "sourceFolder": ".github/scripts/tests",
        "filter": "*",
        "destinationFolder": ".github/scripts/tests"
      }
    ]
  }
}
